{
	"name": "n8n-nodes-kirimi",
	"version": "1.5.0",
	"description": "n8n community node for the Kirimi WhatsApp API (QR devices and WABA Cloud API)",
	"license": "MIT",
	"homepage": "https://github.com/kiriminow/n8n-nodes-kirimi",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"kirimi",
		"whatsapp",
		"otp",
		"messaging"
	],
	"author": {
		"name": "Kirimi Support",
		"email": "support@kirimi.id"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kiriminow/n8n-nodes-kirimi.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KirimiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Kirimi/Kirimi.node.js",
			"dist/nodes/KirimiTrigger/KirimiTrigger.node.js",
			"dist/nodes/KirimiPollTrigger/KirimiPollTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"@types/node": "^20.19.43",
		"eslint": "9.39.4",
		"n8n-workflow": "*",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
